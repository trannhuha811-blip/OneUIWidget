<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Quyền mạng lấy dữ liệu thời tiết Open-Meteo -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Quyền vị trí lấy thời tiết chính xác theo Phường/Xã -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Quyền đọc lịch hiển thị sự kiện & ngày lễ -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Quyền tự động khởi động & nhảy lịch nửa đêm 00:00 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_weather_partly_cloudy"
        android:roundIcon="@drawable/ic_weather_partly_cloudy"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OneUIWidget">

        <!-- MÀN HÌNH CẤU HÌNH TRONG APP -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- APP WIDGET PROVIDER CHO HOME SCREEN WIDGET -->
        <receiver
            android:name=".ui.OneUIWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.oneui.widget.ACTION_REFRESH_WIDGET" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_provider_info" />
        </receiver>

        <!-- RECEIVER NHẢY LỊCH LÚC 00:00 NỬA ĐÊM -->
        <receiver
            android:name=".receiver.MidnightAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.oneui.widget.ACTION_MIDNIGHT_TICK" />
            </intent-filter>
        </receiver>

        <!-- RECEIVER TỰ KHỞI ĐỘNG KHI KHỞI ĐỘNG LẠI MÁY -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
