<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_container"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- PHẦN 1: HÀNG TRÊN CÙNG (KHU VỰC 1: THỜI TIẾT HIỆN TẠI & KHU VỰC 2: NGÀY THÁNG LỊCH DƯƠNG/ÂM) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- KHU VỰC 1: GÓC TRÊN BÊN TRÁI – THỜI TIẾT HIỆN TẠI -->
        <LinearLayout
            android:id="@+id/area_weather_current"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:orientation="vertical">

            <!-- Lời chào tự động theo giờ -->
            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chào buổi sáng"
                android:textColor="@color/white_90"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />

            <!-- Nhiệt độ chính cỡ lớn, thanh mảnh -->
            <TextView
                android:id="@+id/tv_main_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="28°"
                android:textColor="@color/white"
                android:textSize="44sp"
                android:fontFamily="sans-serif-light"
                android:shadowColor="#40000000"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="3"
                android:includeFontPadding="false" />

            <!-- Mô tả thời tiết & vị trí (P. Thạnh Mỹ Tây) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tv_weather_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Có mây rải rác"
                    android:textColor="@color/white_90"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  •  "
                    android:textColor="@color/white_50"
                    android:textSize="12sp" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_location_pin"
                    android:contentDescription="Vị trí" />

                <TextView
                    android:id="@+id/tv_location_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="P. Thạnh Mỹ Tây"
                    android:textColor="@color/white_90"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- 2 Pill Badge viền trắng mảnh: Bình minh / Hoàng hôn & nhiệt độ -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_outline"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_sunrise"
                        android:contentDescription="Sunrise" />

                    <TextView
                        android:id="@+id/tv_sunrise_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="28°C"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_outline"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_sunset"
                        android:contentDescription="Sunset" />

                    <TextView
                        android:id="@+id/tv_sunset_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="27°C"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- KHU VỰC 2: GÓC TRÊN BÊN PHẢI – LỊCH DƯƠNG & LỊCH ÂM VIỆT NAM -->
        <LinearLayout
            android:id="@+id/area_calendar_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.9"
            android:gravity="end"
            android:orientation="vertical">

            <!-- Hàng nút làm mới & Tháng Dương lịch in hoa -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btn_refresh_widget"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_refresh"
                    android:contentDescription="Làm mới" />

                <TextView
                    android:id="@+id/tv_solar_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="THÁNG 11"
                    android:textColor="@color/white_90"
                    android:textSize="14sp"
                    android:letterSpacing="0.05"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Số ngày cực lớn (23) -->
            <TextView
                android:id="@+id/tv_solar_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="23"
                android:textColor="@color/white"
                android:textSize="58sp"
                android:fontFamily="sans-serif-bold"
                android:includeFontPadding="false"
                android:shadowColor="#30000000"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="4" />

            <!-- Thứ (Thứ Hai) -->
            <TextView
                android:id="@+id/tv_day_of_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thứ Hai"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium" />

            <!-- Pill Badge nền trắng đặc, chữ đen đậm: Ngày/Tháng Âm + Can Chi (15/10 Bính Ngọ) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_pill_white"
                android:paddingStart="12dp"
                android:paddingTop="3dp"
                android:paddingEnd="12dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/tv_lunar_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15/10 Bính Ngọ"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ĐƯỜNG KẺ NGĂN CÁCH MỎNG GIỮA PHẦN TRÊN VÀ GIỮA -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:background="@color/white_15" />

    <!-- PHẦN 2: HÀNG Ở GIỮA (KHU VỰC 3: TIMELINE SỰ KIỆN & KHU VỰC 4: LƯỚI LỊCH THÁNG) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- KHU VỰC 3: GIỮA BÊN TRÁI – SỰ KIỆN & NGÀY LỄ VIỆT NAM (DẠNG TIMELINE) -->
        <LinearLayout
            android:id="@+id/area_events_timeline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:orientation="vertical"
            android:paddingEnd="10dp">

            <!-- Sự kiện 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Cột timeline: chấm tròn + vạch kẻ dọc -->
                <LinearLayout
                    android:layout_width="16dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_timeline_dot" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="32dp"
                        android:layout_marginTop="2dp"
                        android:background="@color/timeline_line" />
                </LinearLayout>

                <!-- Nội dung sự kiện 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:orientation="vertical"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/tv_event1_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lễ Giáng sinh (Noel)"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tv_event1_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="25-12 All Day • Ngày lễ Việt Nam"
                        android:textColor="@color/white_70"
                        android:textSize="11sp"
                        android:textStyle="italic"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>

            <!-- Sự kiện 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="16dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_timeline_dot" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_event2_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tết Dương lịch 2027"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tv_event2_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="01-01 All Day • Ngày lễ Việt Nam"
                        android:textColor="@color/white_70"
                        android:textSize="11sp"
                        android:textStyle="italic"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- KHU VỰC 4: GIỮA BÊN PHẢI – LƯỚI LỊCH THÁNG (CALENDAR GRID) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.0">

            <ImageView
                android:id="@+id/img_calendar_grid"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:scaleType="fitCenter"
                android:contentDescription="Lịch tháng" />
        </FrameLayout>
    </LinearLayout>

    <!-- ĐƯỜNG KẺ NGĂN CÁCH MỎNG GIỮA PHẦN GIỮA VÀ DƯỚI -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@color/white_15" />

    <!-- PHẦN 3: KHU VỰC 5 – HÀNG DƯỚI CÙNG: DỰ BÁO 6 NGÀY TỚI + HÔM NAY -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- CỘT TRÁI NGOÀI CÙNG: ICON THỜI TIẾT THỰC TẾ + NHIỆT ĐỘ HIỆN TẠI & MIN/MAX HÔM NAY -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="6dp">

            <ImageView
                android:id="@+id/iv_bottom_today_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_weather_partly_cloudy"
                android:contentDescription="Thời tiết hôm nay" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_bottom_today_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="32°C"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:id="@+id/tv_bottom_today_minmax"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="27°  28°"
                    android:textColor="@color/white_70"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ĐƯỜNG PHÂN CÁCH DỌC MỎNG -->
        <View
            android:layout_width="1dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:background="@color/white_15" />

        <!-- 6 CỘT BÊN PHẢI: HIỂN THỊ 6 NGÀY TIẾP THEO -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4.7"
            android:orientation="horizontal">

            <!-- Ngày 1 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_f1_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="THỨ 3"
                    android:textColor="@color/forecast_gold"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium" />

                <ImageView
                    android:id="@+id/iv_f1_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ic_weather_partly_cloudy"
                    android:contentDescription="icon" />

                <TextView
                    android:id="@+id/tv_f1_min"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="↓ 25°"
                    android:textColor="@color/temp_low_blue"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_f1_max"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↑ 33°"
                    android:textColor="@color/temp_high_orange"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Ngày 2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_f2_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="THỨ 4"
                    android:textColor="@color/forecast_gold"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium" />

                <ImageView
                    android:id="@+id/iv_f2_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ic_weather_sunny"
                    android:contentDescription="icon" />

                <TextView
                    android:id="@+id/tv_f2_min"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="↓ 26°"
                    android:textColor="@color/temp_low_blue"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_f2_max"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↑ 34°"
                    android:textColor="@color/temp_high_orange"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Ngày 3 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_f3_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="THỨ 5"
                    android:textColor="@color/forecast_gold"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium" />

                <ImageView
                    android:id="@+id/iv_f3_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ic_weather_rain"
                    android:contentDescription="icon" />

                <TextView
                    android:id="@+id/tv_f3_min"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="↓ 25°"
                    android:textColor="@color/temp_low_blue"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_f3_max"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↑ 32°"
                    android:textColor="@color/temp_high_orange"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Ngày 4 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_f4_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="THỨ 6"
                    android:textColor="@color/forecast_gold"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium" />

                <ImageView
                    android:id="@+id/iv_f4_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ic_weather_partly_cloudy"
                    android:contentDescription="icon" />

                <TextView
                    android:id="@+id/tv_f4_min"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="↓ 24°"
                    android:textColor="@color/temp_low_blue"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_f4_max"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↑ 33°"
                    android:textColor="@color/temp_high_orange"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Ngày 5 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_f5_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="THỨ 7"
                    android:textColor="@color/forecast_gold"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium" />

                <ImageView
                    android:id="@+id/iv_f5_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ic_weather_thunder"
                    android:contentDescription="icon" />

                <TextView
                    android:id="@+id/tv_f5_min"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="↓ 25°"
                    android:textColor="@color/temp_low_blue"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_f5_max"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↑ 31°"
                    android:textColor="@color/temp_high_orange"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Ngày 6 (Chủ Nhật) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_f6_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CN"
                    android:textColor="@color/red_sunday"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium" />

                <ImageView
                    android:id="@+id/iv_f6_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ic_weather_sunny"
                    android:contentDescription="icon" />

                <TextView
                    android:id="@+id/tv_f6_min"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="↓ 26°"
                    android:textColor="@color/temp_low_blue"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_f6_max"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↑ 35°"
                    android:textColor="@color/temp_high_orange"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
