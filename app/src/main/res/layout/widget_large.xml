<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_container"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="16dp"
    android:paddingEnd="18dp"
    android:paddingBottom="14dp">

    <!-- PHẦN 1: HÀNG TRÊN CÙNG (KHU VỰC 1: THỜI TIẾT, ĐÀN CHIM HẠC & KHU VỰC 2: NGÀY THÁNG LỊCH DƯƠNG/ÂM) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- KHU VỰC 1: GÓC TRÊN BÊN TRÁI – THỜI TIẾT HIỆN TẠI -->
        <LinearLayout
            android:id="@+id/area_weather_current"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:orientation="vertical">

            <!-- Lời chào tự động theo giờ -->
            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Chào buổi sáng"
                android:textColor="@color/white_90"
                android:textSize="14.5sp" />

            <!-- Hàng nhiệt độ & đàn chim hạc bay lượn -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Nhiệt độ chính cỡ lớn, thanh mảnh -->
                <TextView
                    android:id="@+id/tv_main_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:shadowColor="#40000000"
                    android:shadowDx="1"
                    android:shadowDy="2"
                    android:shadowRadius="3"
                    android:text="28°"
                    android:textColor="@color/white"
                    android:textSize="48sp" />

                <!-- ĐÀN CHIM HẠC TRẮNG BAY LƯỢN KHỚP 100% ẢNH MẪU -->
                <ImageView
                    android:id="@+id/iv_flying_cranes"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Đàn chim hạc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_flying_cranes" />
            </LinearLayout>

            <!-- Mô tả thời tiết ở trên: "Có mây rải rác" -->
            <TextView
                android:id="@+id/tv_weather_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Có mây rải rác"
                android:textColor="@color/white_90"
                android:textSize="13sp" />

            <!-- Định vị vị trí ở dưới: "📍 P. Thạnh Mỹ Tây" -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="Vị trí"
                    android:src="@drawable/ic_location_pin" />

                <TextView
                    android:id="@+id/tv_location_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="P. Thạnh Mỹ Tây"
                    android:textColor="@color/white_80"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <!-- 2 Pill Badge viền trắng mảnh: Bình minh / Hoàng hôn & nhiệt độ -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_outline"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:contentDescription="Sunrise"
                        android:src="@drawable/ic_sunrise" />

                    <TextView
                        android:id="@+id/tv_sunrise_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="28°C"
                        android:textColor="@color/white"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pill_outline"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:contentDescription="Sunset"
                        android:src="@drawable/ic_sunset" />

                    <TextView
                        android:id="@+id/tv_sunset_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="27°C"
                        android:textColor="@color/white"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- KHU VỰC 2: GÓC TRÊN BÊN PHẢI – LỊCH DƯƠNG & LỊCH ÂM VIỆT NAM (GRADIENT KHỚP MẪU) -->
        <LinearLayout
            android:id="@+id/area_calendar_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.9"
            android:gravity="end"
            android:orientation="vertical">

            <!-- Tháng Dương lịch in hoa -->
            <TextView
                android:id="@+id/tv_solar_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.08"
                android:text="THÁNG 11"
                android:textColor="@color/white_90"
                android:textSize="14sp" />

            <!-- SỐ NGÀY CỰC LỚN VỚI GRADIENT MỜ DẦN Ở CHÂN SỐ NHƯ BẢN MẪU -->
            <ImageView
                android:id="@+id/img_solar_day"
                android:layout_width="110dp"
                android:layout_height="80dp"
                android:layout_marginTop="-4dp"
                android:contentDescription="Ngày trong tháng"
                android:scaleType="fitEnd" />

            <!-- Giữ TextView cũ cho tính tương thích/fallback -->
            <TextView
                android:id="@+id/tv_solar_day"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- Thứ (Thứ Hai) -->
            <TextView
                android:id="@+id/tv_day_of_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="Thứ Hai"
                android:textColor="@color/white"
                android:textSize="15.5sp" />

            <!-- Pill Badge Lịch Âm 2 phần: [ 15/10  (Bính Ngọ) ] -->
            <LinearLayout
                android:id="@+id/btn_refresh_widget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_pill_outline"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:id="@+id/tv_lunar_day_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:paddingStart="7dp"
                    android:paddingEnd="5dp"
                    android:text="15/10"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <!-- Khung con nền trắng đặc chữ đen đậm cho Can Chi -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_white"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp">

                    <TextView
                        android:id="@+id/tv_lunar_canchi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Bính Ngọ"
                        android:textColor="@color/black"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_lunar_badge"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ĐƯỜNG KẺ PHÂN CÁCH MỎNG GIỮA PHẦN TRÊN VÀ GIỮA -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@color/white_15" />

    <!-- PHẦN 2: HÀNG Ở GIỮA (KHU VỰC 3: TIMELINE SỰ KIỆN & KHU VỰC 4: LƯỚI LỊCH THÁNG) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- KHU VỰC 3: GIỮA BÊN TRÁI – SỰ KIỆN & NGÀY LỄ VIỆT NAM (3 DÒNG KHỚP ẢNH MẪU) -->
        <LinearLayout
            android:id="@+id/area_events_timeline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <!-- Sự kiện 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Cột timeline: chấm tròn + vạch kẻ dọc -->
                <LinearLayout
                    android:layout_width="14dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_timeline_dot" />

                    <FrameLayout
                        android:layout_width="1dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="2dp"
                        android:background="@color/timeline_line" />
                </LinearLayout>

                <!-- Nội dung sự kiện 1: 3 dòng rõ ràng, không bao giờ bị cắt chữ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:orientation="vertical"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/tv_event1_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-bold"
                        android:maxLines="1"
                        android:text="Lễ Giáng Sinh"
                        android:textColor="@color/white"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tv_event1_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="25-12  All Day"
                        android:textColor="@color/white_80"
                        android:textSize="10.5sp"
                        android:textStyle="italic" />

                    <TextView
                        android:id="@+id/tv_event1_source"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Ngày lễ Việt Nam"
                        android:textColor="@color/white_50"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tv_event1_subtitle"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Sự kiện 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="14dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_timeline_dot" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_event2_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-bold"
                        android:maxLines="1"
                        android:text="Tết Dương lịch"
                        android:textColor="@color/white"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tv_event2_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="01-01  All Day"
                        android:textColor="@color/white_80"
                        android:textSize="10.5sp"
                        android:textStyle="italic" />

                    <TextView
                        android:id="@+id/tv_event2_source"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Ngày lễ Việt Nam"
                        android:textColor="@color/white_50"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tv_event2_subtitle"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- KHU VỰC 4: GIỮA BÊN PHẢI – LƯỚI LỊCH THÁNG (CALENDAR GRID CÂN ĐỐI, THOÁNG ĐẸP) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1">

            <ImageView
                android:id="@+id/img_calendar_grid"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:contentDescription="Lịch tháng"
                android:scaleType="fitCenter" />
        </FrameLayout>
    </LinearLayout>

    <!-- ĐƯỜNG KẺ PHÂN CÁCH MỎNG GIỮA PHẦN GIỮA VÀ DƯỚI -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@color/white_15" />

    <!-- PHẦN 3: KHU VỰC 5 – HÀNG DƯỚI CÙNG: DỰ BÁO 6 NGÀY TỚI + HÔM NAY -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- CỘT TRÁI NGOÀI CÙNG: ICON THỜI TIẾT + NHIỆT ĐỘ HIỆN TẠI & MIN/MAX (XẾP DỌC CĂN GIỮA KHỚP ẢNH MẪU) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_bottom_today_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="Thời tiết hôm nay"
                android:src="@drawable/ic_weather_partly_cloudy" />

            <TextView
                android:id="@+id/tv_bottom_today_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="32°C"
                android:textColor="@color/white"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/tv_bottom_today_minmax"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="27°  28°"
                android:textColor="@color/white_70"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 6 CỘT BÊN PHẢI: HIỂN THỊ 6 NGÀY TIẾP THEO -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="5.8"
            android:orientation="horizontal">

            <!-- Ngày 1 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_f1_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="THỨ 3"
                    android:textColor="@color/forecast_gold"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/iv_f1_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="3dp"
                    android:contentDescription="icon"
                    android:src="@drawable/ic_weather_partly_cloudy" />

                <TextView
                    android:id="@+id/tv_f1_min"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="↓ 25°"
                    android:textColor="@color/white_80"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/tv_f1_max"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↑ 33°"
                    android:textColor="@color/white_80"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <!-- Ngày 2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_f2_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="THỨ 4"
                    android:textColor="@color/forecast_gold"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/iv_f2_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="3dp"
                    android:contentDescription="icon"
                    android:src="@drawable/ic_weather_sunny" />

                <TextView
                    android:id="@+id/tv_f2_min"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="↓ 26°"
                    android:textColor="@color/white_80"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/tv_f2_max"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↑ 34°"
                    android:textColor="@color/white_80"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <!-- Ngày 3 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_f3_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="THỨ 5"
                    android:textColor="@color/forecast_gold"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/iv_f3_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="3dp"
                    android:contentDescription="icon"
                    android:src="@drawable/ic_weather_rain" />

                <TextView
                    android:id="@+id/tv_f3_min"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="↓ 25°"
                    android:textColor="@color/white_80"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/tv_f3_max"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↑ 32°"
                    android:textColor="@color/white_80"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <!-- Ngày 4 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_f4_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="THỨ 6"
                    android:textColor="@color/forecast_gold"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/iv_f4_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="3dp"
                    android:contentDescription="icon"
                    android:src="@drawable/ic_weather_partly_cloudy" />

                <TextView
                    android:id="@+id/tv_f4_min"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="↓ 24°"
                    android:textColor="@color/white_80"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/tv_f4_max"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↑ 33°"
                    android:textColor="@color/white_80"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <!-- Ngày 5 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_f5_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="THỨ 7"
                    android:textColor="@color/forecast_gold"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/iv_f5_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="3dp"
                    android:contentDescription="icon"
                    android:src="@drawable/ic_weather_thunder" />

                <TextView
                    android:id="@+id/tv_f5_min"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="↓ 25°"
                    android:textColor="@color/white_80"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/tv_f5_max"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↑ 31°"
                    android:textColor="@color/white_80"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <!-- Ngày 6 (Chủ Nhật) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_f6_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="CN"
                    android:textColor="@color/forecast_gold"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/iv_f6_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="3dp"
                    android:contentDescription="icon"
                    android:src="@drawable/ic_weather_sunny" />

                <TextView
                    android:id="@+id/tv_f6_min"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="↓ 25°"
                    android:textColor="@color/white_80"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/tv_f6_max"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↑ 27°"
                    android:textColor="@color/white_80"
                    android:textSize="9.5sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
